{
  "expo": {
    "name": "TERRY",
    "slug": "terry",
    "scheme": "terry",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.terry.mobile",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "app.terry.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O TERRY usa a câmera para gravar as tomadas do seu roteiro.",
          "microphonePermission": "O TERRY grava o som junto com o vídeo: fala, chapa e ambiente.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O TERRY grava a sua narração por cima da prévia."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O TERRY abre a galeria para você escolher vídeos de referência e clipes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O TERRY abre a galeria para você escolher vídeos.",
          "savePhotosPermission": "O TERRY salva o vídeo exportado na sua galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
